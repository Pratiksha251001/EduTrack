# =======================================================
# EduTrack Institutional Portal Environment Configuration
# =======================================================

# 1. Supabase Database & Authentication
# Paste your Supabase project API settings from Dashboard -> Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 2. Database Connection URL (Optional - Direct DB or PostgreSQL link)
VITE_DATABASE_URL=

# 3. Default Institutional Admin Credentials
# Allows direct sign-in to the Admin Portal without manual first-time setup
VITE_DEFAULT_ADMIN_NAME=
VITE_DEFAULT_ADMIN_EMAIL=
VITE_DEFAULT_ADMIN_PASSWORD=

# 4. Parent SMS Alert Notification Service (Optional)
# Configure an external SMS service or webhook to deliver real-time absence SMS
VITE_SMS_API_URL=
VITE_SMS_API_KEY=

# 5. External Backend API Endpoint (Optional)
VITE_API_BASE_URL=
